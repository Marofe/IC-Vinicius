# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2026a
startdir = D:/codigos_ic/IC-Vinicius/UKF_Lie_coder

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2026a\3P.instrset\mingw_w64.instrset\bin\gcc.exe
cxx = C:\ProgramData\MATLAB\SupportPackages\R2026a\3P.instrset\mingw_w64.instrset\bin\g++.exe
linker = C:\ProgramData\MATLAB\SupportPackages\R2026a\3P.instrset\mingw_w64.instrset\bin\gcc.exe
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2026a\3P.instrset\mingw_w64.instrset\bin\g++.exe

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder\codegen\mex\run_UKF_Lie" -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder" -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder\codegen\mex\run_UKF_Lie\interface" -I "C:\Program Files\MATLAB\R2026a\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=run_UKF_Lie_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder\codegen\mex\run_UKF_Lie" -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder" -I "D:\codigos_ic\IC-Vinicius\UKF_Lie_coder\codegen\mex\run_UKF_Lie\interface" -I "C:\Program Files\MATLAB\R2026a\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=run_UKF_Lie_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

ldflags = run_UKF_Lie.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2026a\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "run_UKF_Lie_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

ldxxflags = run_UKF_Lie.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2026a\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "run_UKF_Lie_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/run_UKF_Lie_data.o : cc $root/run_UKF_Lie_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/run_UKF_Lie_initialize.o : cc $root/run_UKF_Lie_initialize.c
build $builddir/run_UKF_Lie_terminate.o : cc $root/run_UKF_Lie_terminate.c
build $builddir/prediction_UKF_Lie.o : cc $root/prediction_UKF_Lie.c
build $builddir/SigmaPointsLie.o : cc $root/SigmaPointsLie.c
build $builddir/eig.o : cc $root/eig.c
build $builddir/anyNonFinite.o : cc $root/anyNonFinite.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/eye.o : cc $root/eye.c
build $builddir/exp_multiSE23T6.o : cc $root/exp_multiSE23T6.c
build $builddir/norm.o : cc $root/norm.c
build $builddir/mtimes.o : cc $root/mtimes.c
build $builddir/lu.o : cc $root/lu.c
build $builddir/log_multiSE23T6.o : cc $root/log_multiSE23T6.c
build $builddir/diag.o : cc $root/diag.c
build $builddir/squeeze.o : cc $root/squeeze.c
build $builddir/mldivide.o : cc $root/mldivide.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/evaluateStateRMSE.o : cc $root/evaluateStateRMSE.c
build $builddir/mean.o : cc $root/mean.c
build $builddir/_coder_run_UKF_Lie_api.o : cc $root/interface/_coder_run_UKF_Lie_api.c
build $builddir/_coder_run_UKF_Lie_mex.o : cc $root/interface/_coder_run_UKF_Lie_mex.c
build $builddir/eml_int_forloop_overflow_error.o : cc $root/eml_int_forloop_overflow_error.c
build $builddir/run_UKF_Lie.o : cc $root/run_UKF_Lie.c
build $builddir/chol.o : cc $root/chol.c
build $builddir/sind.o : cc $root/sind.c
build $builddir/cosd.o : cc $root/cosd.c
build $builddir/eulerENU2NED.o : cc $root/eulerENU2NED.c
build $builddir/eml_mtimes_helper.o : cc $root/eml_mtimes_helper.c
build $builddir/run_UKF_Lie_emxutil.o : cc $root/run_UKF_Lie_emxutil.c
build $builddir/run_UKF_Lie_mexutil.o : cc $root/run_UKF_Lie_mexutil.c
build $builddir/_coder_run_UKF_Lie_info.o : cc $root/interface/_coder_run_UKF_Lie_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\run_UKF_Lie_mex.mexw64 : link $builddir/run_UKF_Lie_data.o $builddir/rt_nonfinite.o $builddir/run_UKF_Lie_initialize.o $builddir/run_UKF_Lie_terminate.o $builddir/prediction_UKF_Lie.o $builddir/SigmaPointsLie.o $builddir/eig.o $builddir/anyNonFinite.o $builddir/warning.o $builddir/eye.o $builddir/exp_multiSE23T6.o $builddir/norm.o $builddir/mtimes.o $builddir/lu.o $builddir/log_multiSE23T6.o $builddir/diag.o $builddir/squeeze.o $builddir/mldivide.o $builddir/sumMatrixIncludeNaN.o $builddir/evaluateStateRMSE.o $builddir/mean.o $builddir/_coder_run_UKF_Lie_api.o $builddir/_coder_run_UKF_Lie_mex.o $builddir/eml_int_forloop_overflow_error.o $builddir/run_UKF_Lie.o $builddir/chol.o $builddir/sind.o $builddir/cosd.o $builddir/eulerENU2NED.o $builddir/eml_mtimes_helper.o $builddir/run_UKF_Lie_emxutil.o $builddir/run_UKF_Lie_mexutil.o $builddir/_coder_run_UKF_Lie_info.o $builddir/c_mexapi_version.o 
